{{!-- RNK™ Vellum — actor-sheet.hbs --}}
{{!-- © 2026 RNK Enterprise. All rights reserved. See LICENSE. --}}
<form class="vellum-sheet" autocomplete="off">

  <div class="vellum-header">

    {{!-- Portrait — square (default ~128×128) --}}
    <div class="vellum-portrait-cell">
      <img class="vellum-portrait" src="{{actor.img}}"
           title="Click to change portrait" alt="Portrait" />
    </div>

    {{!-- Identity fields --}}
    <div class="vellum-identity-cell">
      <div class="vellum-row">
        <span class="vellum-label">Name:</span>
        <input class="vellum-input vellum-actor-name" type="text"
               value="{{actor.name}}" />
      </div>
      <div class="vellum-row vellum-row--identity-meta">
        <span class="vellum-label">Class:</span>
        <input class="vellum-input vellum-input--class" type="text"
               data-vellum-field="className" value="{{vellum.className}}" />
        <span class="vellum-label">Level:</span>
        <input class="vellum-input vellum-input--sm" type="number"
               data-vellum-field="level" value="{{vellum.level}}" min="1" max="20" />
        <span class="vellum-label">XP:</span>
        <input class="vellum-input vellum-input--sm" type="number"
               data-vellum-field="xp" value="{{vellum.xp}}" min="0" />
        <span class="vellum-xp-max">/{{xpMax}}</span>
      </div>
      <div class="vellum-row vellum-row--hp">
        <span class="vellum-label">HP:</span>
        <input class="vellum-input vellum-input--xs" type="number"
               data-vellum-field="hp.value" value="{{vellum.hp.value}}" />
        <span class="vellum-sep">/</span>
        <input class="vellum-input vellum-input--xs" type="number"
               data-vellum-field="hp.max" value="{{vellum.hp.max}}" />
      </div>
    </div>

    {{!-- Animal Deity Portrait + Blessings --}}
    <div class="vellum-deity-cell">
      <img class="vellum-deity-portrait"
           src="{{#if vellum.animalDeityPortrait}}{{vellum.animalDeityPortrait}}{{else}}icons/svg/mystery-man.svg{{/if}}"
           title="Animal Deity — click to change portrait" alt="Animal Deity" />
      <div class="vellum-blessings-label">Blessings</div>
      <div class="vellum-blessings-row">
        {{#if showB1}}
        <button type="button"
                class="vellum-blessing{{#if vellum.blessings.b1}} vellum-blessing--active{{/if}}"
                data-key="b1"
                title="Blessing token - click to spend or restore"></button>
        {{/if}}
        {{#if showB2}}
        <button type="button"
                class="vellum-blessing{{#if vellum.blessings.b2}} vellum-blessing--active{{/if}}"
                data-key="b2"
                title="Blessing token - click to spend or restore"></button>
        {{/if}}
        {{#if showB3}}
        <button type="button"
                class="vellum-blessing{{#if vellum.blessings.b3}} vellum-blessing--active{{/if}}"
                data-key="b3"
                title="Blessing token - click to spend or restore"></button>
        {{/if}}
      </div>
    </div>

  </div>

  <div class="vellum-lower">

    {{!-- Background Panel --}}
    <div class="vellum-background-cell">

      <div class="vellum-background-top">
        <div class="vellum-ac-cell vellum-ac-cell--inline">
          <div class="vellum-shield-wrap">
            <svg class="vellum-shield-svg" viewBox="0 0 60 72" xmlns="http://www.w3.org/2000/svg">
              <path d="M30 4 L56 16 L56 38 Q56 58 30 68 Q4 58 4 38 L4 16 Z"
                    class="vellum-shield-path" />
            </svg>
            <input class="vellum-ac-input" type="text"
                   data-vellum-field="ac" value="{{vellum.ac}}"
                   {{#if acFromSystem}}readonly{{/if}}
                   title="{{#if acFromSystem}}Armor Class (from game system){{else}}Armor Class - e.g. 10, 10+1, 10/12{{/if}}" />
          </div>
        </div>

        <div class="vellum-attributes-cell">
          <div class="vellum-section-header">Attributes</div>
          <div class="vellum-stats-panel">
            <div class="vellum-stats-grid">
              <div class="vellum-stats-col">
                {{#each statsLeft}}
                <div class="vellum-stat-row">
                  <button type="button" class="vellum-stat-roll" data-stat="{{key}}" data-mod="{{mod}}" title="Roll {{label}} check">{{label}}</button>
                  <input class="vellum-stat-score" type="number"
                         data-vellum-field="{{scoreField}}" value="{{score}}" />
                  <span class="vellum-sep">/</span>
                  <span class="vellum-stat-mod vellum-stat-mod--computed" title="Auto-computed from score">{{modDisplay}}</span>
                </div>
                {{/each}}
              </div>
              <div class="vellum-stats-col">
                {{#each statsRight}}
                <div class="vellum-stat-row">
                  <button type="button" class="vellum-stat-roll" data-stat="{{key}}" data-mod="{{mod}}" title="Roll {{label}} check">{{label}}</button>
                  <input class="vellum-stat-score" type="number"
                         data-vellum-field="{{scoreField}}" value="{{score}}" />
                  <span class="vellum-sep">/</span>
                  <span class="vellum-stat-mod vellum-stat-mod--computed" title="Auto-computed from score">{{modDisplay}}</span>
                </div>
                {{/each}}
              </div>
            </div>
          </div>
        </div>
      </div>

      {{!-- Talents / Traits (Adrian: Flaws → Traits, upper box → Talents) --}}
      <div class="vellum-bg-sections" id="vellum-bg-sections">
        {{#each bgSections}}
        <div class="vellum-bg-section" data-section="{{key}}" draggable="true">
          <div class="vellum-bg-label-row">
            <span class="vellum-bg-section-drag" title="Drag to reorder section">⠿</span>
            <span class="vellum-bg-label">{{label}}</span>
            {{#if @root.isOwner}}
            <button type="button" class="vellum-btn--ghost-sm vellum-trait-add" data-category="{{key}}" title="Add {{label}}">+</button>
            {{/if}}
          </div>
          <div class="vellum-trait-list" data-category="{{key}}">
            {{#each items}}
            <div class="vellum-trait-row" data-item-id="{{itemId}}" title="{{description}}" draggable="true">
              <span class="vellum-trait-drag">⠿</span>
              {{#if itemImg}}<img class="vellum-trait-img" src="{{itemImg}}" alt="" />{{/if}}
              <span class="vellum-trait-name">{{itemName}}</span>
              <button type="button" class="vellum-trait-btn vellum-trait-delete" title="Remove">&#x2715;</button>
            </div>
            {{/each}}
          </div>
        </div>
        {{/each}}
      </div>

      <div class="vellum-bg-block vellum-bg-block--inline">
        <span class="vellum-bg-label">Phobia</span>
        <input class="vellum-input" type="text"
               data-vellum-field="phobia" value="{{vellum.phobia}}" />
      </div>

      <div class="vellum-bg-block">
        <span class="vellum-bg-label">Effects</span>
        <textarea class="vellum-textarea" rows="2"
                  data-vellum-field="effects">{{vellum.effects}}</textarea>
      </div>

      <div class="vellum-gp-row">
        <span class="vellum-label">GP:</span>
        <input class="vellum-input vellum-input--sm" type="number"
               data-vellum-field="gp.value" value="{{vellum.gp.value}}" />
        <span class="vellum-sep">/</span>
        <input class="vellum-input vellum-input--sm" type="number"
               data-vellum-field="gp.max" value="{{vellum.gp.max}}" />
      </div>

      <div class="vellum-charm-slot">
        <span class="vellum-charm-label">Charm</span>
        {{#if charmItem}}
        <div class="vellum-charm-row" data-item-id="{{charmItem.itemId}}">
          {{#if charmItem.itemImg}}<img class="vellum-inv-img" src="{{charmItem.itemImg}}" alt="" />{{/if}}
          <span class="vellum-item-name vellum-charm-name">{{charmItem.itemName}}</span>
          <div class="vellum-inv-actions">
            <button type="button" class="vellum-inv-btn vellum-item-edit" title="Edit">✎</button>
            <button type="button" class="vellum-inv-btn vellum-charm-unequip" title="Remove from Charm slot">✕</button>
          </div>
        </div>
        {{else}}
        <div class="vellum-charm-empty">— empty —</div>
        {{/if}}
      </div>

    </div>

    {{!-- Right column: Attacks & Abilities + numbered Inventory --}}
    <div class="vellum-inventory-cell">

      {{!-- Attacks & Abilities (Adrian request) --}}
      <div class="vellum-section-header">Attacks &amp; Abilities</div>
      <div class="vellum-attacks-list" id="vellum-attacks">
        {{#if hasAttacks}}
          {{#each attacksItems}}
          <div class="vellum-inv-row {{#if equipped}}vellum-inv-row--equipped{{/if}}"
               data-slot="{{slot}}"
               data-item-id="{{itemId}}"
               data-is-weapon="{{isWeapon}}"
               data-is-container="{{isContainer}}"
               data-is-notepad="{{isNotepad}}"
               draggable="true">
            <div class="vellum-inv-main">
              {{#if itemImg}}
              <img class="vellum-inv-img" src="{{itemImg}}" alt="" />
              {{/if}}
              <div class="vellum-inv-info">
                <span class="vellum-item-name" title="{{#if isContainer}}Double-click to open container{{else}}{{#if isNotepad}}Double-click to open notepad{{else}}Click to open{{/if}}{{/if}}">{{itemName}}</span>
                {{#if tags.length}}
                <span class="vellum-inv-tags">
                  {{#each tags}}<span class="vellum-inv-tag">{{this}}</span>{{/each}}
                </span>
                {{/if}}
              </div>
            </div>
            <div class="vellum-inv-actions">
              {{#if isRollable}}
              <button type="button" class="vellum-inv-btn vellum-item-roll" title="Roll">&#9860;</button>
              {{/if}}
              <button type="button" class="vellum-inv-btn vellum-item-equip"
                      title="{{#if equipped}}Unequip{{else}}Equip{{/if}}">{{#if equipped}}▼{{else}}▲{{/if}}</button>
              <button type="button" class="vellum-inv-btn vellum-item-edit" title="Edit">✎</button>
              <button type="button" class="vellum-inv-btn vellum-item-delete" title="Remove">✕</button>
            </div>
          </div>
          {{/each}}
        {{else}}
          <div class="vellum-attacks-empty">No weapons, spells, or abilities yet.</div>
        {{/if}}
      </div>

      {{!-- Cairn-style numbered inventory --}}
      <div class="vellum-section-header">
        Inventory
        <span class="vellum-inv-counter">{{inventoryUsed}}/{{inventoryMax}}</span>
        {{#if isOwner}}
        <div class="vellum-inv-add-wrap">
          <button type="button" class="vellum-btn--ghost vellum-inv-add" title="Add item">+ Add ▾</button>
          <div class="vellum-inv-add-menu" hidden>
            <button type="button" class="vellum-inv-add-option" data-inv-type="standard">Item</button>
            <button type="button" class="vellum-inv-add-option" data-inv-type="container">Container</button>
            <button type="button" class="vellum-inv-add-option" data-inv-type="notepad">Notepad</button>
          </div>
        </div>
        {{/if}}
      </div>
      <div class="vellum-inventory-list vellum-inventory-slots" id="vellum-inv-slots">

        {{#each inventorySlots}}
        <div class="vellum-inv-slot {{#if empty}}vellum-inv-slot--empty{{else}}vellum-inv-slot--filled{{/if}}{{#if isContinuation}} vellum-inv-slot--cont{{/if}}{{#if overflow}} vellum-inv-slot--overflow{{/if}}{{#if equipped}} vellum-inv-slot--equipped{{/if}}"
             data-slot-num="{{slotNum}}"
             {{#if itemId}}data-item-id="{{itemId}}"{{/if}}>
          <span class="vellum-inv-slot-num">{{slotNum}}.</span>
          {{#if empty}}
          <div class="vellum-inv-slot-empty">—</div>
          {{else if isContinuation}}
          <div class="vellum-inv-slot-cont" title="{{itemName}} (multi-slot)">
            <span class="vellum-inv-slot-cont-bar"></span>
            <span class="vellum-inv-slot-cont-label">{{itemName}}</span>
          </div>
          {{else}}
          <div class="vellum-inv-row {{#if equipped}}vellum-inv-row--equipped{{/if}}"
               data-slot="{{slot}}"
               data-item-id="{{itemId}}"
               data-is-weapon="{{isWeapon}}"
               data-is-container="{{isContainer}}"
               data-is-notepad="{{isNotepad}}"
               draggable="true">
            <div class="vellum-inv-main">
              {{#if itemImg}}
              <img class="vellum-inv-img" src="{{itemImg}}" alt="" />
              {{/if}}
              <div class="vellum-inv-info">
                <span class="vellum-item-name" title="{{#if isContainer}}Double-click to open container{{else}}{{#if isNotepad}}Double-click to open notepad{{else}}Click to open{{/if}}{{/if}}">{{itemName}}</span>
                {{#if tags.length}}
                <span class="vellum-inv-tags">
                  {{#each tags}}<span class="vellum-inv-tag">{{this}}</span>{{/each}}
                </span>
                {{/if}}
              </div>
            </div>
            <div class="vellum-inv-actions">
              {{#if isRollable}}
              <button type="button" class="vellum-inv-btn vellum-item-roll" title="Roll">&#9860;</button>
              {{/if}}
              <button type="button" class="vellum-inv-btn vellum-item-equip"
                      title="{{#if equipped}}Unequip{{else}}Equip{{/if}}">{{#if equipped}}▼{{else}}▲{{/if}}</button>
              <button type="button" class="vellum-inv-btn vellum-item-edit" title="Edit">✎</button>
              <button type="button" class="vellum-inv-btn vellum-item-delete" title="Remove">✕</button>
            </div>
          </div>
          {{/if}}
        </div>
        {{/each}}

      </div>
    </div>

  </div>

</form>
