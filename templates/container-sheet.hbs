<div class="vellum-container-sheet">

  <div class="vellum-container-info">
    <strong>{{item.name}}</strong>
    &nbsp;·&nbsp; {{used}} / {{capacity}} slots used
    {{#if overCapacity}}
    <span class="vellum-container-overflow">over capacity</span>
    {{/if}}
  </div>

  <div class="vellum-container-list">
    {{#each slots}}
    <div class="vellum-container-slot{{#if hasItem}} vellum-container-slot--filled{{else}} vellum-container-slot--empty{{/if}}"
         data-index="{{index}}">
      <span class="vellum-container-slot-num">{{add index 1}}.</span>
      {{#if hasItem}}
      <div class="vellum-container-item vellum-inv-row" data-item-id="{{itemId}}" draggable="true">
        <div class="vellum-inv-main">
          {{#if itemImg}}<img class="vellum-inv-img vellum-container-item-img" src="{{itemImg}}" alt="" />{{/if}}
          <div class="vellum-inv-info">
            <span class="vellum-item-name vellum-container-item-name">{{itemName}}</span>
          </div>
        </div>
        <div class="vellum-inv-actions">
          <button type="button" class="vellum-inv-btn vellum-container-remove" title="Move to player inventory">×</button>
        </div>
      </div>
      {{else}}
        {{#if label}}
        <div class="vellum-container-legacy">{{label}}</div>
        {{else}}
        <div class="vellum-container-empty">Drop item here</div>
        {{/if}}
      {{/if}}
    </div>
    {{/each}}
  </div>

  <div class="vellum-container-footer">
    <button type="button" class="vellum-btn--ghost container-add-slot">
      + Add Slot
    </button>
  </div>

</div>
